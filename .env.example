# ============================================================
# MarineRadar / Global Ship Tracker - Environment Configuration
# ============================================================

# --- AIS Telemetry Stream ---
# Required for stream_client.py live AIS ingestion
AISSTREAM_API_KEY=your_aisstream_api_key_here

# Required by AISStream. Coordinates use [[latitude, longitude],
# [latitude, longitude]]. Leave unset for the default global coverage.
# AISSTREAM_BOUNDING_BOXES=[[[25.835,-80.208],[25.603,-79.879]]]

# --- PostgreSQL / PostGIS Database ---
# For Docker Compose deployments (auto-populated by compose defaults)
POSTGRES_DB=marineradar
POSTGRES_USER=marineradar
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_PORT=5432

# Database connection string used by FastAPI and Ingestion worker.
# In Docker Compose, the database host is 'db'.
# If left empty, the application seamlessly defaults to local SQLite (data/ships.db).
DATABASE_URL=postgresql://marineradar:generate_a_secure_password_here@db:5432/marineradar

# --- Web & API Server ---
PORT=8502
CORS_ORIGINS=*
